<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>title</key>
  <string>Gif2Ani</string>
  <key>items</key>
  <array>
    <dict>
      <key>cell</key><string>PSGroupCell</string>
      <key>label</key><string>REAL RESPRING ANIMATION</string>
      <key>footerText</key><string>Replaces the BackBoard respring spinner with your own animated GIF. If the GIF cannot load, iOS falls back to the normal animation.</string>
    </dict>
    <dict>
      <key>cell</key><string>PSSwitchCell</string>
      <key>label</key><string>Enable Gif2Ani</string>
      <key>defaults</key><string>com.nightvibes33.gif2ani</string>
      <key>key</key><string>isEnabled</string>
      <key>default</key><true/>
      <key>PostNotification</key><string>com.nightvibes33.gif2ani/ReloadPrefs</string>
    </dict>

    <dict>
      <key>cell</key><string>PSGroupCell</string>
      <key>label</key><string>ANIMATION</string>
    </dict>
    <dict>
      <key>cell</key><string>PSLinkCell</string>
      <key>label</key><string>Select GIF</string>
      <key>action</key><string>selectGIF</string>
    </dict>
    <dict>
      <key>cell</key><string>PSLinkCell</string>
      <key>label</key><string>Remove Current GIF</string>
      <key>action</key><string>removeGIF</string>
    </dict>

    <dict>
      <key>cell</key><string>PSGroupCell</string>
      <key>label</key><string>LAYOUT</string>
    </dict>
    <dict>
      <key>cell</key><string>PSLinkListCell</string>
      <key>label</key><string>Scaling</string>
      <key>detail</key><string>PSListItemsController</string>
      <key>defaults</key><string>com.nightvibes33.gif2ani</string>
      <key>key</key><string>imageTransformation</string>
      <key>default</key><string>resizeAspect</string>
      <key>validTitles</key>
      <array><string>Fit</string><string>Fill</string><string>Stretch</string><string>Center</string></array>
      <key>validValues</key>
      <array><string>resizeAspect</string><string>resizeAspectFill</string><string>resize</string><string>center</string></array>
      <key>PostNotification</key><string>com.nightvibes33.gif2ani/ReloadPrefs</string>
    </dict>
    <dict>
      <key>cell</key><string>PSLinkCell</string>
      <key>label</key><string>Background Color</string>
      <key>action</key><string>chooseBackgroundColor</string>
    </dict>

    <dict>
      <key>cell</key><string>PSGroupCell</string>
      <key>label</key><string>PLAYBACK</string>
      <key>footerText</key><string>Use -1 for the GIF's original loop behavior or duration.</string>
    </dict>
    <dict>
      <key>cell</key><string>PSSliderCell</string>
      <key>label</key><string>Loop Count</string>
      <key>defaults</key><string>com.nightvibes33.gif2ani</string>
      <key>key</key><string>customLoop</string>
      <key>default</key><real>-1</real>
      <key>min</key><real>-1</real>
      <key>max</key><real>10</real>
      <key>showValue</key><true/>
      <key>PostNotification</key><string>com.nightvibes33.gif2ani/ReloadPrefs</string>
    </dict>
    <dict>
      <key>cell</key><string>PSSliderCell</string>
      <key>label</key><string>Duration (Seconds)</string>
      <key>defaults</key><string>com.nightvibes33.gif2ani</string>
      <key>key</key><string>customDuration</string>
      <key>default</key><real>-1</real>
      <key>min</key><real>-1</real>
      <key>max</key><real>60</real>
      <key>showValue</key><true/>
      <key>PostNotification</key><string>com.nightvibes33.gif2ani/ReloadPrefs</string>
    </dict>

    <dict>
      <key>cell</key><string>PSGroupCell</string>
      <key>footerText</key><string>Applying will respring the iPad. The first respring also records whether the required iOS 16 BackBoard classes were found.</string>
    </dict>
    <dict>
      <key>cell</key><string>PSButtonCell</string>
      <key>label</key><string>Apply and Respring</string>
      <key>action</key><string>respring</string>
    </dict>
  </array>
</dict>
</plist>
