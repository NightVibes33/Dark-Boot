<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>title</key>
  <string>Gif2Ani</string>
  <key>items</key>
  <array>
    <dict>
      <key>cell</key><string>PSGroupCell</string>
      <key>label</key><string>SAFE RESPRING ANIMATION</string>
      <key>footerText</key><string>Selecting a GIF only stages and validates it. Nothing is decoded until you explicitly tap Apply and Respring. Apply always enables the staged animation; Remove disables it.</string>
    </dict>

    <dict>
      <key>cell</key><string>PSGroupCell</string>
      <key>label</key><string>ANIMATION</string>
      <key>footerText</key><string>Safety limits for the 2 GB iPad: 25 MB input, 24 decoded frames, 640 px maximum dimension, and about 48 MB decoded memory.</string>
    </dict>
    <dict>
      <key>cell</key><string>PSLinkCell</string>
      <key>label</key><string>Select and Stage GIF</string>
      <key>action</key><string>selectGIF</string>
    </dict>
    <dict>
      <key>cell</key><string>PSLinkCell</string>
      <key>label</key><string>Remove Staged and Active GIF</string>
      <key>action</key><string>removeGIF</string>
    </dict>

    <dict>
      <key>cell</key><string>PSGroupCell</string>
      <key>label</key><string>LAYOUT</string>
      <key>footerText</key><string>Layout changes are saved but are not sent live to backboardd. They take effect on the next Apply and Respring.</string>
    </dict>
    <dict>
      <key>cell</key><string>PSLinkListCell</string>
      <key>label</key><string>Scaling</string>
      <key>detail</key><string>PSListItemsController</string>
      <key>defaults</key><string>com.nightvibes33.gif2ani</string>
      <key>key</key><string>imageTransformation</string>
      <key>default</key><string>resizeAspect</string>
      <key>validTitles</key>
      <array><string>Fit</string><string>Fill</string><string>Stretch</string><string>Center</string></array>
      <key>validValues</key>
      <array><string>resizeAspect</string><string>resizeAspectFill</string><string>resize</string><string>center</string></array>
    </dict>
    <dict>
      <key>cell</key><string>PSLinkCell</string>
      <key>label</key><string>Background Color</string>
      <key>action</key><string>chooseBackgroundColor</string>
    </dict>

    <dict>
      <key>cell</key><string>PSGroupCell</string>
      <key>label</key><string>PLAYBACK</string>
      <key>footerText</key><string>Use -1 for the GIF's original loop behavior or duration. Changes apply only after an explicit respring.</string>
    </dict>
    <dict>
      <key>cell</key><string>PSSliderCell</string>
      <key>label</key><string>Loop Count</string>
      <key>defaults</key><string>com.nightvibes33.gif2ani</string>
      <key>key</key><string>customLoop</string>
      <key>default</key><real>-1</real>
      <key>min</key><real>-1</real>
      <key>max</key><real>10</real>
      <key>showValue</key><true/>
    </dict>
    <dict>
      <key>cell</key><string>PSSliderCell</string>
      <key>label</key><string>Duration (Seconds)</string>
      <key>defaults</key><string>com.nightvibes33.gif2ani</string>
      <key>key</key><string>customDuration</string>
      <key>default</key><real>-1</real>
      <key>min</key><real>-1</real>
      <key>max</key><real>60</real>
      <key>showValue</key><true/>
    </dict>

    <dict>
      <key>cell</key><string>PSGroupCell</string>
      <key>footerText</key><string>Apply atomically promotes the staged GIF, verifies that isEnabled is true in the real preferences file, and restarts BackBoard so the animation callback actually runs. If loading fails, the GIF is automatically quarantined.</string>
    </dict>
    <dict>
      <key>cell</key><string>PSButtonCell</string>
      <key>label</key><string>Apply and Respring</string>
      <key>action</key><string>applyAndRespring</string>
    </dict>
  </array>
</dict>
</plist>
