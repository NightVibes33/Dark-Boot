<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>title</key>
  <string>Gif2Ani</string>
  <key>items</key>
  <array>
    <dict>
      <key>cell</key><string>PSGroupCell</string>
      <key>label</key><string>GIF2ANI 3.5.4</string>
      <key>footerText</key><string>114 first-class themes: 12 offline, 54 pinned CC0 downloads, and 48 original Springy pack downloads. Nothing contacts BackBoard until you explicitly tap Apply and Respring.</string>
    </dict>
    <dict>
      <key>cell</key><string>PSButtonCell</string>
      <key>label</key><string>Current Status and Diagnostics</string>
      <key>action</key><string>showStatus</string>
    </dict>

    <dict>
      <key>cell</key><string>PSGroupCell</string>
      <key>label</key><string>114-THEME ANIMATION GALLERY</string>
      <key>footerText</key><string>Tap any downloadable theme to fetch its verified original file, preview it, and stage it. Then return here to choose scaling, background, repeat, and duration before Apply. The 48 Springy DEBs are extracted for animation media only; the old packages are never installed.</string>
    </dict>
    <dict>
      <key>cell</key><string>PSButtonCell</string>
      <key>label</key><string>Browse and Preview Animations</string>
      <key>id</key><string>G2ThemeGallery</string>
      <key>action</key><string>openAnimationGallery</string>
    </dict>

    <dict>
      <key>cell</key><string>PSGroupCell</string>
      <key>label</key><string>YOUR ANIMATION FILE</string>
      <key>footerText</key><string>Safety limits for this 2 GB iPad: 25 MB GIF input, 240 source frames, 24 decoded frames, 640 px maximum decoded dimension, and 48 MB estimated decoded memory. Downloaded DEBs and archives also have strict path, file-count, and extracted-size limits.</string>
    </dict>
    <dict>
      <key>cell</key><string>PSButtonCell</string>
      <key>label</key><string>Select and Stage GIF</string>
      <key>action</key><string>selectGIF</string>
    </dict>
    <dict>
      <key>cell</key><string>PSButtonCell</string>
      <key>label</key><string>Remove Staged and Active GIF</string>
      <key>action</key><string>confirmRemoveGIF</string>
    </dict>

    <dict>
      <key>cell</key><string>PSGroupCell</string>
      <key>label</key><string>LAYOUT</string>
      <key>footerText</key><string>Fit preserves the whole animation. Fill crops to cover the display. Stretch changes its aspect ratio. Center keeps the decoded pixel size. Changes take effect on the next Apply and Respring.</string>
    </dict>
    <dict>
      <key>cell</key><string>PSLinkListCell</string>
      <key>label</key><string>Scaling</string>
      <key>detail</key><string>PSListItemsController</string>
      <key>defaults</key><string>com.nightvibes33.gif2ani</string>
      <key>key</key><string>imageTransformation</string>
      <key>default</key><string>resizeAspect</string>
      <key>validTitles</key>
      <array><string>Fit</string><string>Fill</string><string>Stretch</string><string>Center</string></array>
      <key>validValues</key>
      <array><string>resizeAspect</string><string>resizeAspectFill</string><string>resize</string><string>center</string></array>
    </dict>
    <dict>
      <key>cell</key><string>PSButtonCell</string>
      <key>label</key><string>Background Color</string>
      <key>action</key><string>chooseBackgroundColor</string>
    </dict>

    <dict>
      <key>cell</key><string>PSGroupCell</string>
      <key>label</key><string>PLAYBACK</string>
      <key>footerText</key><string>Loop Forever repeats continuously. Play Once uses zero repeats. Original GIF Timing preserves the animation’s own timing; a custom duration scales playback to the selected total time.</string>
    </dict>
    <dict>
      <key>cell</key><string>PSLinkListCell</string>
      <key>label</key><string>Repeat Mode</string>
      <key>detail</key><string>PSListItemsController</string>
      <key>defaults</key><string>com.nightvibes33.gif2ani</string>
      <key>key</key><string>customLoop</string>
      <key>default</key><real>-1</real>
      <key>validTitles</key>
      <array>
        <string>Loop Forever</string><string>Play Once</string><string>Repeat Once</string>
        <string>Repeat 2 Times</string><string>Repeat 3 Times</string><string>Repeat 5 Times</string><string>Repeat 10 Times</string>
      </array>
      <key>validValues</key>
      <array><real>-1</real><real>0</real><real>1</real><real>2</real><real>3</real><real>5</real><real>10</real></array>
    </dict>
    <dict>
      <key>cell</key><string>PSLinkListCell</string>
      <key>label</key><string>Total Animation Duration</string>
      <key>detail</key><string>PSListItemsController</string>
      <key>defaults</key><string>com.nightvibes33.gif2ani</string>
      <key>key</key><string>customDuration</string>
      <key>default</key><real>-1</real>
      <key>validTitles</key>
      <array>
        <string>Original GIF Timing</string><string>0.5 Seconds</string><string>1 Second</string><string>2 Seconds</string><string>3 Seconds</string>
        <string>5 Seconds</string><string>10 Seconds</string><string>15 Seconds</string><string>30 Seconds</string><string>60 Seconds</string>
      </array>
      <key>validValues</key>
      <array><real>-1</real><real>0.5</real><real>1</real><real>2</real><real>3</real><real>5</real><real>10</real><real>15</real><real>30</real><real>60</real></array>
    </dict>
    <dict>
      <key>cell</key><string>PSButtonCell</string>
      <key>label</key><string>Reset Layout and Playback</string>
      <key>action</key><string>resetVisualAndPlaybackSettings</string>
    </dict>

    <dict>
      <key>cell</key><string>PSGroupCell</string>
      <key>footerText</key><string>Apply revalidates the staged or active GIF, normalizes every setting, keeps a rollback copy while promoting new media, verifies the enabled state on disk, clears stale safety files, and restarts BackBoard. A failed runtime load is automatically quarantined and Apple’s normal animation remains available.</string>
    </dict>
    <dict>
      <key>cell</key><string>PSButtonCell</string>
      <key>label</key><string>Apply and Respring</string>
      <key>action</key><string>applyAndRespring</string>
    </dict>
  </array>
</dict>
</plist>
