#!/bin/sh
set -eu

MEDIA_DIR="/var/mobile/Library/Application Support/DarkBoot"
mkdir -p "$MEDIA_DIR"
chown mobile:mobile "$MEDIA_DIR" 2>/dev/null || true
chmod 0755 "$MEDIA_DIR" 2>/dev/null || true

# PreferenceLoader discovers the pane on the next Preferences launch.
# Terminating Preferences here guarantees the newly installed pane appears
# the next time Settings is opened, without a manual cache-cleaning step.
killall -9 Preferences 2>/dev/null || true

# Apply tweak injection after dpkg has fully finished configuring the package.
(
    sleep 2
    if [ -x /var/jb/usr/bin/sbreload ]; then
        /var/jb/usr/bin/sbreload >/dev/null 2>&1 || true
    elif [ -x /usr/bin/sbreload ]; then
        /usr/bin/sbreload >/dev/null 2>&1 || true
    else
        killall -9 SpringBoard >/dev/null 2>&1 || true
    fi
) >/dev/null 2>&1 &

exit 0
